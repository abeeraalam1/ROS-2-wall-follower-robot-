Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Reference Frame: odom
      Cell Size: 0.5
      Plane Cell Count: 20
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Size (m): 0.04
      Color Transformer: FlatColor
      Color: 255; 85; 0
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: true
      Keep: 200
      Shape:
        Value: Arrow
      Topic:
        Value: /odom
    - Class: rviz_default_plugins/Path
      Name: Waypoints
      Enabled: true
      Color: 25; 255; 0
      Pose Style: Axes
      Topic:
        Value: /waypoint_follower/path
        Durability Policy: Transient Local
  Global Options:
    Fixed Frame: odom
    Frame Rate: 30
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 80
      X: 0.5
      Y: 1.7
Window Geometry:
  Width: 1200
  Height: 800
